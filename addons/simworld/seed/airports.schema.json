{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simworld.local/seed/airports.schema.json",
  "title": "SimWorld seed airport file (airports.json)",
  "description": "Airports and runways of a region, cut from OurAirports (public domain) by `simworld-cli seed airports` (docs/spec-world-seed.md section 4.3). Sorted by ident. Unknown numbers (an end OurAirports lacks, a missing width) are null. The game reads the same file (or airports()) so the drawn runway and the game's runway are one source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "source", "source_date", "airports"],
  "$defs": {
    "lat_or_null": { "description": "Latitude, WGS84 degrees, or null when unknown.", "type": ["number", "null"], "minimum": -85, "maximum": 85 },
    "lon_or_null": { "description": "Longitude, WGS84 degrees, or null when unknown.", "type": ["number", "null"], "minimum": -180, "maximum": 180 },
    "feet_or_null": { "description": "Feet, or null when unknown.", "type": ["number", "null"], "minimum": 0, "maximum": 100000 },
    "runway": {
      "description": "One runway (OurAirports runways.csv row). Key in overrides: \"<le>/<he>\".",
      "type": "object",
      "additionalProperties": false,
      "required": ["le", "he"],
      "properties": {
        "le": { "description": "Low end designator (le_ident), e.g. 08.", "type": "string", "pattern": "^[^/]*$" },
        "he": { "description": "High end designator (he_ident), e.g. 26; empty when OurAirports has none.", "type": "string", "pattern": "^[^/]*$" },
        "length_ft": { "$ref": "#/$defs/feet_or_null" },
        "width_ft": { "$ref": "#/$defs/feet_or_null" },
        "surface": { "description": "OurAirports surface code (ASP, CON, PEM, BIT, GRS, TURF, DIRT, GRE, ...).", "type": "string" },
        "lighted": { "description": "OurAirports lighted = 1.", "type": "boolean" },
        "closed": { "description": "OurAirports closed = 1 (closed runways are not drawn).", "type": "boolean" },
        "le_lat": { "$ref": "#/$defs/lat_or_null" },
        "le_lon": { "$ref": "#/$defs/lon_or_null" },
        "he_lat": { "$ref": "#/$defs/lat_or_null" },
        "he_lon": { "$ref": "#/$defs/lon_or_null" },
        "le_heading_degT": { "description": "True heading of the le end, degrees, or null.", "type": ["number", "null"], "minimum": 0, "maximum": 360 },
        "le_displaced_threshold_ft": { "$ref": "#/$defs/feet_or_null" },
        "he_displaced_threshold_ft": { "$ref": "#/$defs/feet_or_null" }
      }
    }
  },
  "properties": {
    "format": { "description": "File format version. This library reads 1.", "type": "integer", "const": 1 },
    "source": { "description": "Data source (OurAirports).", "type": "string" },
    "source_date": { "description": "Download date of the CSVs, YYYY-MM-DD.", "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "airports": {
      "description": "Airports sorted by ident.",
      "type": "array",
      "items": {
        "description": "One airport.",
        "type": "object",
        "additionalProperties": false,
        "required": ["ident", "type", "lat", "lon", "runways"],
        "properties": {
          "ident": { "description": "OurAirports ident (unique).", "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "type": { "description": "OurAirports type.", "type": "string", "enum": ["large_airport", "medium_airport", "small_airport", "heliport", "seaplane_base", "balloonport", "closed"] },
          "name": { "description": "Airport name.", "type": "string" },
          "lat": { "description": "Reference point latitude.", "type": "number", "minimum": -85, "maximum": 85 },
          "lon": { "description": "Reference point longitude.", "type": "number", "minimum": -180, "maximum": 180 },
          "elevation_ft": { "description": "Field elevation (informational), feet, or null.", "type": ["number", "null"], "minimum": -2000, "maximum": 30000 },
          "country": { "description": "ISO country code.", "type": "string" },
          "runways": { "description": "Runways in le/he order.", "type": "array", "items": { "$ref": "#/$defs/runway" } }
        }
      }
    }
  }
}
