{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel)\"/.claude/hooks/guard-generated.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel)\"/.claude/hooks/sync-addon.sh" }
        ]
      }
    ]
  }
}
