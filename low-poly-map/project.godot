; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LowPolyMap"
run/main_scene="res://scenes/CitySpike.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
config/icon="res://icon.svg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="LowPolyMap"

[editor_plugins]

enabled=PackedStringArray("res://addons/simworld/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"

[shader_globals]

simworld_night_factor={
"type": "float",
"value": 1.0
}
simworld_hour={
"type": "float",
"value": 12.0
}
simworld_curve_center={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
simworld_curve_inv_2r={
"type": "float",
"value": 0.0
}
