; SimPlane WorldStreamer GDExtension (Rust, gdext 0.5.x, api-4-7).
; Owned by the Rust side (rust-world-streamer). Cargo workspace in ../rust/ (outside the project);
; this loads the simworld-godot crate (libsimworld_godot.*), which wraps simworld-core.
; Build: cd ../rust && cargo build            (debug, used by the editor)
;        cd ../rust && cargo build --release  (release exports)

[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
macos.debug = "res://../rust/target/debug/libsimworld_godot.dylib"
macos.release = "res://../rust/target/release/libsimworld_godot.dylib"
; iOS (later): static xcframework built from the staticlib target, copied into the project, e.g.
; ios.debug = "res://bin/ios/simworld_godot.debug.xcframework"
; ios.release = "res://bin/ios/simworld_godot.release.xcframework"
