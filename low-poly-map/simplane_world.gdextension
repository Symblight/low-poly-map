; SimPlane WorldStreamer GDExtension (Rust, gdext 0.5.x, api-4-7).
; Owned by the Rust side (rust-world-streamer). Crate lives in ../rust/ (outside the project).
; Build: cd ../rust && cargo build            (debug, used by the editor)
;        cd ../rust && cargo build --release  (release exports)

[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
macos.debug = "res://../rust/target/debug/libsimplane_world.dylib"
macos.release = "res://../rust/target/release/libsimplane_world.dylib"
; iOS (later): static xcframework built from the staticlib target, copied into the project, e.g.
; ios.debug = "res://bin/ios/simplane_world.debug.xcframework"
; ios.release = "res://bin/ios/simplane_world.release.xcframework"
